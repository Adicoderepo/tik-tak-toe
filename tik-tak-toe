import random                  # Random number generate karne ke liye
from tkinter import *          # Tkinter GUI banane ke liye
from tkinter import messagebox # Message box dikhane ke liye
# Main window create
root = Tk()
# Window ka title
root.title("Tic Tac Toe")
# Window ka size
root.geometry("1000x900")
# Window ka background color
root.config(bg="lightblue")
# Pehla player X hoga
FIRST_PLAYER = "X"
# Sabhi buttons ko store karne ke liye list
buttons = []
# Winner check karne wala function
def check_winner():
    # Winning combinations
    win_cond = [
        [0,1,2],   # First row
        [3,4,5],   # Second row
        [6,7,8],   # Third row
        [0,3,6],   # First column
        [1,4,7],   # Second column
        [2,5,8],   # Third column
        [0,4,8],   # Left diagonal
        [2,4,6]    # Right diagonal
    ]
    # Har winning condition check karo
    for cond in win_cond:
        # Agar tino button same hain aur khaali nahi hain
        if buttons[cond[0]]["text"] == buttons[cond[1]]["text"] == buttons[cond[2]]["text"] != "":
            # Winner ka message
            messagebox.showinfo(
                "Game Over",
                f"Player {buttons[cond[0]]['text']} congratulations!"
            )
            # Game reset
            reset_game()
            return True
    # Draw check karne ke liye
    full = True
    # Dekho koi button khaali hai ya nahi
    for btn in buttons:
        if btn["text"] == "":
            full = False
    # Agar board full hai
    if full:
        # Draw message
        messagebox.showinfo("Game Over", "Match Draw Ho Gaya!")
        # Reset game
        reset_game()
        return True
    return False
# Game ko reset karne wala function
def reset_game():
    global FIRST_PLAYER
    # X se game start hoga
    FIRST_PLAYER = "X"

    # Sabhi button khaali karo
    for btn in buttons:
        btn.config(text="")
# Computer ki move
def computer_move():
    # Winning combinations
    win_cond = [
        [0,1,2],
        [3,4,5],
        [6,7,8],
        [0,3,6],
        [1,4,7],
        [2,5,8],
        [0,4,8],
        [2,4,6]
    ]
    # Pehle computer jeetne ki koshish karega
    for cond in win_cond:
        line = [
            buttons[cond[0]]["text"],
            buttons[cond[1]]["text"],
            buttons[cond[2]]["text"]
        ]
        # Agar 2 O aur 1 khaali box hai
        if line.count("O") == 2 and line.count("") == 1:
            # Khaali box ka index
            index = cond[line.index("")]
             # Wahan O laga do
            buttons[index].config(text="O")
            # Winner check
            check_winner()
            return
    # Player ko block karna
    for cond in win_cond:
        line = [
            buttons[cond[0]]["text"],
            buttons[cond[1]]["text"],
            buttons[cond[2]]["text"]
        ]
        # Agar Player ke 2 X hain
        if line.count("X") == 2 and line.count("") == 1:
            index = cond[line.index("")]
            # Computer O laga dega
            buttons[index].config(text="O")
            check_winner()
            return
    # Agar koi special move nahi mili
    empty_buttons = []
    # Khaali button list me add karo
    for btn in buttons:
        if btn["text"] == "":
            empty_buttons.append(btn)
    # Agar khaali button hai
    if len(empty_buttons) > 0:
        # Random button choose karo
        btn = random.choice(empty_buttons)
        # O laga do
        btn.config(text="O")
        # Winner check
        check_winner()
# Player ki move
def first_value(btn):
    global FIRST_PLAYER
    # Agar button khaali hai aur X ki turn hai
    if btn["text"] == "" and FIRST_PLAYER == "X":
        # X laga do
        btn.config(text="X")
        # Winner check
        if check_winner():
            return
        # Turn computer ki
        FIRST_PLAYER = "O"
        # Computer move
        computer_move()
        # Fir player ki turn
        FIRST_PLAYER = "X"
# ---------------- Frame ----------------
# Board ke liye frame
frame = Frame(root, bg="lightblue")
# Frame window me show karo
frame.pack(pady=20)
# 9 buttons banao
for i in range(9):
    # Row calculate
    row = i // 3
    # Column calculate
    col = i % 3
    # Button create
    btn = Button(
        frame,
        text="",
        width=5,
        height=2,
        font=("Arial", 24, "bold"),
        bg="lightgreen",
        fg="red"
    )
    # Button ko grid me rakho
    btn.grid(
        row=row,
        column=col,
        padx=10,
        pady=10
    )
    # Button click hone par function call hoga
    btn.config(command=lambda b=btn: first_value(b))
    # Button list me add karo
    buttons.append(btn)
# Program start karo
root.mainloop() 
